# ====================================================
# EcoGrid Energy - Environment Configuration Template
# ====================================================

# Database Configuration
DATABASE_PATH=data/ecogrid.db

# Event Bus & Resilience Settings
MAX_RETRIES=3
EVENT_RETRY_DELAY=0.01

# Marketplace Pricing Defaults (AUD per kWh)
DEFAULT_ENERGY_PRICE=0.25
DEFAULT_BUYER_MAX_PRICE=0.30

# Simulation Configuration
SIMULATION_METERS=20
SIMULATION_READINGS_PER_METER=50
SIMULATION_DELAY=0.0

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
